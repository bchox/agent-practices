{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/bchox/agent-practices/main/catalog.schema.json",
  "title": "Agent Practices catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "projectVersion", "skills", "templates"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "projectVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "description", "path"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "description": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "pattern": "^skills/[a-z0-9-]+/SKILL\\.md$" }
        }
      }
    },
    "templates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "path"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "path": { "type": "string", "pattern": "^templates/[a-z0-9-]+/AGENTS\\.md$" }
        }
      }
    }
  }
}
